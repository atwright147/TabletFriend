<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logo.ico</ApplicationIcon>
	<Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Receive native touch/pen contact lifetimes instead of compatibility mouse clicks. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="MaterialDesignThemes" Version="4.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="WindowsInput" Version="6.4.1" />
    <PackageReference Include="YamlDotNet" Version="11.2.1" />
  </ItemGroup>


  <ItemGroup>
    <None Update="files/**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="files/**/*" LogicalName="Bundled/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Migration/bundled-hashes.json" LogicalName="Migration/bundled-hashes.json" />
  </ItemGroup>
</Project>
